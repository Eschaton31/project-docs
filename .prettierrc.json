{
  "printWidth": 120,
  "semi": false,
  "bracketSameLine": true,
  "trailingComma": "es5",
  "tabWidth": 2,
  "singleQuote": true,
  "bracketSpacing": true,
  "arrowParens": "always",
  "singleAttributePerLine": false,
  "htmlWhitespaceSensitivity": "css",
  "importOrder": [
    "^vue$",
    "^@inertiajs/(.*)$",
    "^primevue/(.*)$",
    "^@headlessui/(.*)$",
    "^@heroicons/(.*)$",
    "^@fortawesome/(.*)$",
    "^@core/(.*)$",
    "^@server/(.*)$",
    "^@ui/(.*)$",
    "^@vueuse/(.*)$",
    "^@tiptap/vue-3",
    "^@tiptap/extensions-(.*)$",
    "^@assets/geojson/muncities(.*)$",
    "^@assets/geojson/aem(.*)$",
    "^@/composables/(.*)$",
    "^@/components/buttons/(.*)$",
    "^@/components/forms/(.*)$",
    "^@/components/ui/(.*)$",
    "^@/components/modals/(.*)$",
    "^@/components/tables/(.*)$",
    "^@/components/forms/Fields/(.*)$",
    "^@/components/forms/Groups/(.*)$",
    "^@/components/forms/Sections/(.*)$",
    "^@/components/(.*)$",
    "^@/layouts/(.*)$",
    "^@/pages/(.*)$",
    "^@/stores/(.*)$",
    "^echarts/core",
    "^echarts/renderers",
    "^echarts/charts",
    "^echarts/components",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "plugins": ["@trivago/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"]
}
