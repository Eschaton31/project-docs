APP_NAME="Project Docs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=project_docs
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

AI_REVIEW_ENABLED=true
# claude-code: Claude Code with your own Claude plan (no API key needed). The account below starts reviews
#   from the editor (the ai-review worker runs `claude -p`); anyone can also run /prose-review in Claude Code.
#   Check the worker's account with: php artisan prose-review:check-claude
# api: any admin starts reviews from the editor; the queue calls the API with ANTHROPIC_API_KEY
AI_REVIEW_RUNNER=claude-code
AI_REVIEW_CLAUDE_CODE_USER=
# full path if the worker's account doesn't find `claude` (an npm install on Windows is claude.cmd)
AI_REVIEW_CLAUDE_BINARY=claude
ANTHROPIC_API_KEY=
AI_REVIEW_MODEL=claude-sonnet-5-5
AI_REVIEW_OPUS_MODEL=claude-opus-5-5
AI_REVIEW_QUEUE_CONNECTION=ai-review

VITE_APP_NAME="${APP_NAME}"
